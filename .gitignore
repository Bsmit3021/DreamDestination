# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real credentials)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw source downloads: reproducible via npm run data:fetch, not committed
/data/raw/

# Derived from the manually-downloaded BLS archive (also ignored); 12 MB.
# The uncompressed 12 MB build artefact. The gzipped copy beside it (1.4 MB) IS
# committed, because production bootstrap must work from a fresh clone and BLS
# blocks automated download of the archive it is derived from.
# Reproduce with: npm run data:career:extract && npm run data:career:transform
/data/processed/career-stats.json
