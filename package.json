{
  "name": "dreamdestination",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:fetch": "tsx scripts/city-data/fetch.ts",
    "data:transform": "tsx scripts/city-data/transform.ts",
    "data:validate": "tsx scripts/city-data/validate.ts",
    "data:seed": "tsx --env-file=.env.local scripts/city-data/seed.ts",
    "data:occupations:transform": "tsx scripts/occupations/transform.ts",
    "data:occupations:seed": "tsx --env-file=.env.local scripts/occupations/seed.ts",
    "data:occupations:fetch": "tsx scripts/occupations/fetch.ts",
    "data:career:extract": "python3 scripts/career/extract_oews.py",
    "data:career:transform": "tsx scripts/career/transform.ts",
    "data:career:validate": "tsx scripts/career/validate.ts",
    "data:career:seed": "tsx --env-file=.env.local scripts/career/seed.ts",
    "data:housing:fetch": "tsx scripts/housing/pipeline.ts fetch",
    "data:housing:transform": "tsx scripts/housing/pipeline.ts transform",
    "data:housing:validate": "tsx scripts/housing/pipeline.ts validate",
    "data:housing:seed": "tsx --env-file=.env.local scripts/housing/seed.ts",
    "data:safety:fetch": "tsx scripts/safety/pipeline.ts fetch",
    "data:safety:extract": "python3 scripts/safety/extract_cius.py",
    "data:safety:transform": "tsx scripts/safety/pipeline.ts transform",
    "data:safety:validate": "tsx scripts/safety/pipeline.ts validate",
    "data:safety:seed": "tsx --env-file=.env.local scripts/safety/seed.ts",
    "data:family:fetch": "tsx scripts/family/pipeline.ts fetch",
    "data:family:transform": "tsx scripts/family/pipeline.ts transform",
    "data:family:validate": "tsx scripts/family/pipeline.ts validate",
    "data:family:seed": "tsx --env-file=.env.local scripts/family/seed.ts",
    "data:lifestyle:fetch": "tsx scripts/lifestyle/pipeline.ts fetch",
    "data:lifestyle:extract": "python3 scripts/lifestyle/extract_places.py",
    "data:lifestyle:transform": "tsx scripts/lifestyle/pipeline.ts transform",
    "data:lifestyle:validate": "tsx scripts/lifestyle/pipeline.ts validate",
    "data:lifestyle:seed": "tsx --env-file=.env.local scripts/lifestyle/seed.ts",
    "data:city-data:seed": "tsx --env-file=.env.local scripts/city-data/seed.ts",
    "data:bootstrap": "tsx --env-file=.env.local scripts/bootstrap/seed-all.ts",
    "data:bootstrap:verify": "tsx --env-file=.env.local scripts/bootstrap/seed-all.ts verify"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "openai": "^7.5.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@supabase/postgres-meta": "^0.98.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
