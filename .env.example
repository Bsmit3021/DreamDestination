# DreamDestination environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). `.env.local` is gitignored.
#
# NOTE: every value below is a placeholder. No real credentials are committed
# to this repository.

# ---------------------------------------------------------------------------
# Public (browser-safe) — inlined into the client bundle by Next.js.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Base URL of your Supabase project, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Safe for the browser: it is constrained by Row Level
# Security, so it can only reach rows your RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only — MUST NOT be exposed to the browser.
# ---------------------------------------------------------------------------

# Service-role key. Bypasses Row Level Security entirely. Only ever read in
# server-side code (see lib/supabase/admin.ts, which is marked `server-only`).
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ---------------------------------------------------------------------------
# Canonical site URL (optional locally, REQUIRED in production)
# ---------------------------------------------------------------------------
# The absolute origin of this deployment, used to build the email-confirmation
# link Supabase sends on sign-up. Set it to the exact production domain and use
# the same value as the project's Supabase Auth "Site URL".
#
# Resolution is keyed on VERCEL_ENV, not a fall-through list:
#   production  -> this value, else VERCEL_PROJECT_PRODUCTION_URL
#   preview     -> VERCEL_URL only (this value is deliberately ignored, so a
#                  dashboard entry scoped to "all environments" cannot send
#                  preview confirmation emails to production)
#   development -> this value, else http://localhost:3000
# Public by design: it is an origin, not a secret.
#
# Preview deployments need a matching Supabase redirect allow-list entry. The
# documented wildcard is https://*-<team-or-account-slug>.vercel.app/** — the
# wildcard goes on the LEFT, because a preview hostname is
# <project>-<hash>-<team-slug>.vercel.app. For this project:
#   https://*-briansmith01cs-7446.vercel.app/**
NEXT_PUBLIC_SITE_URL=http://localhost:3000
