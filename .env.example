# DreamDestination environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). `.env.local` is gitignored.
#
# NOTE: every value below is a placeholder. No real credentials are committed
# to this repository.

# ---------------------------------------------------------------------------
# Public (browser-safe) — inlined into the client bundle by Next.js.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Base URL of your Supabase project, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Safe for the browser: it is constrained by Row Level
# Security, so it can only reach rows your RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only — MUST NOT be exposed to the browser.
# ---------------------------------------------------------------------------

# Service-role key. Bypasses Row Level Security entirely. Only ever read in
# server-side code (see lib/supabase/admin.ts, which is marked `server-only`).
SUPABASE_SERVICE_ROLE_KEY=
